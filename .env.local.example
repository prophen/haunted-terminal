# Copy to .env.local and fill in. Never commit real keys.
# Story model. Defaults to cloud (the hosted demo needs it).
GEMMA_MODE=cloud
# gemma-4-26b-a4b-it is the lightest Gemma 4 on AI Studio (gemma-4-31b-it is
# heavier). For faster turns try a Gemma 3 model such as gemma-3-12b-it or
# gemma-3-4b-it; the code handles their missing system-prompt support.
GEMMA_CLOUD_MODEL=gemma-4-26b-a4b-it
GOOGLE_AI_STUDIO_KEY=
# Narration. Same key shape as Talk to the Book.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
