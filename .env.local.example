# Copy to .env.local and fill in. Never commit real keys.
# Story model. Defaults to cloud (the hosted demo needs it).
GEMMA_MODE=cloud
# gemma-4-26b-a4b-it is the lightest Gemma on AI Studio (gemma-4-31b-it is
# heavier; Gemma 3 models are no longer served there).
GEMMA_CLOUD_MODEL=gemma-4-26b-a4b-it
GOOGLE_AI_STUDIO_KEY=
# Faster hosting for open-weight models (GEMMA_MODE=router). OpenRouter by
# default, serving the same Gemma 4. For Groq, set
# ROUTER_BASE_URL=https://api.groq.com/openai/v1 and a Groq model id.
ROUTER_API_KEY=
# ROUTER_BASE_URL=https://openrouter.ai/api/v1
# ROUTER_MODEL=google/gemma-4-26b-a4b-it
# Narration. Same key shape as Talk to the Book.
ELEVENLABS_API_KEY=
# Callum (husky, intense premade voice). Swap for any voice id from your
# ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=N2lVS1w4EtoT3dr4eOWO
